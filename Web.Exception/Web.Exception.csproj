<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>Web.Exception</PackageId>
    <!-- <Version>1.0.2</Version> -->
    <VersionPrefix>1.0.3</VersionPrefix>
    <VersionSuffix>dev-002</VersionSuffix>
    <Authors>Dio Liew</Authors>
    <Description>A package to ease the configuration of Web Exception.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageDescription>A package to ease the configuration of Web Exception.</PackageDescription>
    <RepositoryUrl>https://github.com/DioLiew/Web.Exception/tree/main</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
      <None Include="README.md" Pack="true" PackagePath="\"/>
   </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CSharpExt.Core" Version="1.1.1-dev-001" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Serilog.Exceptions" Version="8.4.0" />
  </ItemGroup>
</Project>
